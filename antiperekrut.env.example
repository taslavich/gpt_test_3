# Antiperekrut is always enabled in production mode. There is no
# ANTIPEREKRUT_MODE and no ANTIPEREKRUT_STARTUP_RESET_ENABLED switch.

# Shared by adm-adapter, spp-adapter, orchestrator, router, bid-engine and adv.
# The same strong secret must be injected into every included service through
# Kubernetes Secret / Secret Manager. Do not commit the real value.
ANTIPEREKRUT_INTERNAL_SECRET=CHANGE_ME

# Comma-separated direct internal HTTP addresses of every ADV replica.
# Do not use one load-balanced URL: startup fan-out must reach every replica.
ADV_SERVICE_CONTROL_URLS=http://adv-1.internal:8101,http://adv-2.internal:8101,http://adv-3.internal:8101

# Optional tuning; these defaults are already defined in config.
ANTIPEREKRUT_CONTROL_TIMEOUT=3s
ANTIPEREKRUT_RETRY_INITIAL=1s
ANTIPEREKRUT_RETRY_MAX=1m

# Required in every included service for startup/reset and background errors.
BOT_BASE_URL=https://telegram-bot.internal
BOT_INTERNAL_SECRET=CHANGE_ME

# ADV only.
ANTIPEREKRUT_TICK_OFFSET=3s
# Normally false: the cabinet migration should run before ORTB rollout.
ANTIPEREKRUT_AUTO_MIGRATE=false

# ADV also requires its existing PostgreSQL and ClickHouse settings:
# POSTGRES_DSN=postgres://...
# CLICKHOUSE_HOST=...
# CLICKHOUSE_PORT=9440
# CLICKHOUSE_DB=ads
# CLICKHOUSE_USERNAME=...
# CLICKHOUSE_PASSWORD=...

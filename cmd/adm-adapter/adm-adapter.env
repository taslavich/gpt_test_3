HTTP_HOSTNAME=0.0.0.0
HTTP_PORT=443

NURL_TIMEOUT=10s

FULLCHAIN_PEM=./adm-fullchain.pem
PRIVKEY_PEM=./adm-privkey.pem
RSA_FULLCHAIN_PEM=./adm-rsa-fullchain.pem
RSA_PRIVKEY_PEM=./adm-rsa-privkey.pem

REDIS_HOST=buffer.twinbidexchange.com
REDIS_PORT=6380

REDIS_SHARD_ADDRS=127.0.0.1:7000,127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003,127.0.0.1:7004
REDIS_SHARD_TLS_ADDRS=buffer.twinbidexchange.com:8000,buffer.twinbidexchange.com:8001,buffer.twinbidexchange.com:8002,buffer.twinbidexchange.com:8003,buffer.twinbidexchange.com:8004
REDIS_USE_TLS=true
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=16

REDIS_DB=0
REDIS_DB_ORTB=0
REDIS_DB_IMPRESSIONS=1
REDIS_DB_CLICKS=2

REDIS_SET_IMPRESSIONS=impressions:ready
REDIS_SET_CLICKS=clicks:ready
REDIS_PASSWORD=redis121
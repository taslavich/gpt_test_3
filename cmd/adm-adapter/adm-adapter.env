HTTP_HOSTNAME=0.0.0.0
HTTP_PORT=443

ADM_TIMEOUT=10s
BURL_TIMEOUT=10s

FULLCHAIN_PEM=./adm-fullchain.pem
PRIVKEY_PEM=./adm-privkey.pem
RSA_FULLCHAIN_PEM=./adm-rsa-fullchain.pem
RSA_PRIVKEY_PEM=./adm-rsa-privkey.pem


# Общий пароль для всех Redis

REDIS_PASSWORD=redis121

REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=16


# Redis №1: шардированный Redis статистики

REDIS_SHARD_ADDRS=buffer.twinbidexchange.com:7000,buffer.twinbidexchange.com:7001,buffer.twinbidexchange.com:7002,buffer.twinbidexchange.com:7003
REDIS_SHARD_TLS_ADDRS=buffer.twinbidexchange.com:8000,buffer.twinbidexchange.com:8001,buffer.twinbidexchange.com:8002,buffer.twinbidexchange.com:8003
REDIS_USE_TLS=false

REDIS_DB_IMPRESSIONS=5
REDIS_DB_CLICKS=6
REDIS_DB_CONVERSIONS=7

REDIS_SET_IMPRESSIONS=impressions_v2:ready
REDIS_SET_CLICKS=clicks_v2:ready
REDIS_SET_CONVERSIONS=conversions_v2:ready


# Redis №2: UUID обычных DSP

REDIS_UUID_ADDR=buffer.twinbidexchange.com:6379

REDIS_DB_ADM=1
REDIS_DB_BURL=0


# Redis №3: данные ADV

REDIS_ADV_ADDR=buffer.twinbidexchange.com:7005

REDIS_DB_ADV_RUNTIME=5
REDIS_DB_ADV_WINNER=6


# Контроль ошибок Redis

REDIS_WRITE_ERROR_LOG_THRESHOLD_PER_SEC=20
REDIS_WRITE_ERROR_STOP_THRESHOLD_PER_SEC=80
REDIS_WRITE_ERROR_MONITOR_TICKER_INTERVAL=10s

SSP_ADAPTER_WORK_STATUS_URL=http://127.0.0.1:8050


# HTTP-control ADV

ADV_SERVICE_CONTROL_URLS=http://server4.twinbidexchange.com:8101


# Durable outbox

ADV_OUTBOX_PATH=/var/lib/twinbid/adm-adapter/adv-billing-outbox.db
ADV_OUTBOX_RETRY_INTERVAL=2s
ADV_OUTBOX_MAX_BACKOFF=1m
ADV_APPLIED_MARKER_TTL=720h


# Внутренние уведомления

BOT_BASE_URL=http://twinbidexchange.com:8095
BOT_INTERNAL_SECRET=3f2c8a9e-6d4b-4a1e-9c7d-5f8b3e2a1d6c
ANTIPEREKRUT_CONTROL_TIMEOUT=3s
ANTIPEREKRUT_RETRY_INITIAL=1s
ANTIPEREKRUT_RETRY_MAX=1m

HOSTNAME=0.0.0.0
PORT=8089

URI_OF_BID_ENGINE=0.0.0.0:8084

CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=<inject same deployment secret as clickhouse-loader>
CLICKHOUSE_DB=ads
CLICKHOUSE_HOST=click.twinbidexchange.com
CLICKHOUSE_PORT=9440
# Stage 04 durable observability/history
PERCENTER_OUTBOX_PATH=./data/percenter-observability-outbox.db
PERCENTER_RELAY_INTERVAL=1m
PERCENTER_HISTORY_TABLE=percenter_state_history
PERCENTER_TELEMETRY_TABLE=percenter_telemetry
KAFKA_TOPIC_PERCENTER=percenter_observability
# Use the same existing Kafka cluster; no new Kafka instance is required.
KAFKA_BROKERS=127.0.0.1:9092
PERCENTER_DIGEST_INTERVAL=30m
# BOT_BASE_URL and BOT_INTERNAL_SECRET are optional; if either is absent, Telegram delivery is disabled.

BOT_BASE_URL=
BOT_INTERNAL_SECRET=

# Stage 05 production contract. REDIS_ADV_ADDR/REDIS_PASSWORD must reference
# the same existing Redis instance used by ADV; optimizer state is logical DB 7.
REDIS_ADV_ADDR=buffer.twinbidexchange.com:7005
# REDIS_PASSWORD must be injected from the same deployment secret used by ADV.
REDIS_DB_ADV_PERCENTER=7
CLICKHOUSE_TABLE_ORTB=ortb
CLICKHOUSE_TABLE_IMPRESSIONS=impressions_in
CLICKHOUSE_TABLE_CLICKS=clicks_in
SIMPLE_OPTIMIZE_INTERVAL=5m
SIMPLE_REBENCHMARK_INTERVAL=6h
SIMPLE_STATE_TTL=168h
SIMPLE_MIN_IMPRESSIONS=5
SIMPLE_WIN_RATE_RETENTION=0.5
SIMPLE_MARGIN_SEARCH_STEPS=5,2,1
SIMPLE_MAX_MARGIN=0.9
COMPLEX_OPTIMIZE_INTERVAL=5m
COMPLEX_REBENCHMARK_INTERVAL=6h
COMPLEX_STATE_TTL=168h
COMPLEX_MIN_IMPRESSIONS=5
COMPLEX_BUYOUT_RETENTION=0.8
COMPLEX_EFFICIENCY_RETENTION=0.8
COMPLEX_SSP_SEARCH_STEPS=10,5,2,1
COMPLEX_MARGIN_SEARCH_STEPS=10,5,2,1
COMPLEX_MAX_MARGIN=0.9

# Stage 06: independent recovery retention for committed pending history.
# Default 720h (30d); choose an operational value that covers outage + deploy/restart + recovery backlog.
HISTORY_PENDING_TTL=720h

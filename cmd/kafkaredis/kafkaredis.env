# KafkaRedis spent_totals bridge configuration. Values are placeholders; do not commit secrets here.
ADV_REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=16
REDIS_DB_ADV_RUNTIME=5

POSTGRES_DSN=postgres://user:password@postgres:5432/rtb?sslmode=disable

KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_ORTB=ortb
KAFKA_TOPIC_IMPRESSIONS=impressions
KAFKA_TOPIC_CLICKS=clicks
KAFKA_TOPIC_CONVERSIONS=conversions
KAFKA_TOPIC_SPENT_TOTALS=spent_totals
KAFKA_GROUP_ID_SPENT_TOTALS=groupIdSpentTotals
KAFKA_SPENT_TOTALS_PARTITIONS=1
KAFKA_SPENT_TOTALS_REPLICATION_FACTOR=1

KAFKAREDIS_EXPORTER_INTERVAL=30s
KAFKAREDIS_REDIS_SCAN_COUNT=1000
KAFKAREDIS_FETCH_BACKOFF=1s
KAFKAREDIS_HTTP_HOST=0.0.0.0
KAFKAREDIS_HTTP_PORT=8095
KAFKAREDIS_SELF_CONTROL_URL=http://127.0.0.1:8095/work_status/postgres_sync
KAFKAREDIS_SELF_CONTROL_TIMEOUT=2s

BOT_BASE_URL=
BOT_INTERNAL_SECRET=

HTTP_HOSTNAME=0.0.0.0
HTTP_PORT=8097
KAFKAREDIS_SELF_CONTROL_URL=http://127.0.0.1:8097/work_status/postgres_sync

REDIS_UUID_ADDR=buffer.twinbidexchange.com:6379
REDIS_PASSWORD=redis121
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNS=8
REDIS_DB_ADV_RUNTIME=5

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC_SPENT_TOTALS=spent_totals
KAFKA_GROUP_ID_SPENT_TOTALS=kafkaredis-spent-totals

# Redis DB5 -> Kafka. SCAN/MGET and Kafka writes are bounded; Redis is never cleared.
KAFKAREDIS_REDIS_EXPORT_INTERVAL=30s
KAFKAREDIS_REDIS_SCAN_COUNT=2000
KAFKAREDIS_KAFKA_EXPORT_BATCH_SIZE=2000
KAFKAREDIS_KAFKA_EXPORT_BATCH_BYTES=4194304

# Kafka -> PostgreSQL. The importer reads continuously; there is no sleep after a successful batch.
KAFKAREDIS_KAFKA_IMPORT_BATCH_SIZE=2000
KAFKAREDIS_KAFKA_IMPORT_BATCH_TIMEOUT=100ms
KAFKAREDIS_IMPORT_DISABLED_POLL_INTERVAL=250ms

# PostgreSQL connection pool for the batch importer.
KAFKAREDIS_POSTGRES_MAX_OPEN_CONNS=8
KAFKAREDIS_POSTGRES_MAX_IDLE_CONNS=8
KAFKAREDIS_POSTGRES_CONN_MAX_LIFETIME=30m

# POSTGRES_DSN must be injected by deployment; no test credentials are shipped.
POSTGRES_DSN=

BOT_BASE_URL=http://twinbidexchange.com:8095
# BOT_INTERNAL_SECRET must be injected by deployment.
BOT_INTERNAL_SECRET=

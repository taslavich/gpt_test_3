PUB_LISTEN=127.0.0.1:8087
PUB_PUBLIC_URL=https://pub.example.com
PUBLISHER_REDIS_ADDRS=127.0.0.1:6379
PUBLISHER_REDIS_CLUSTER=false
PUBLISHER_REDIS_USERNAME=
PUBLISHER_REDIS_PASSWORD=
PUBLISHER_REDIS_TLS=false
PUB_INTERNAL_SECRET=REPLACE_WITH_RANDOM_AT_LEAST_32_CHARS
PUB_DELIVERY_SECRET=REPLACE_WITH_ANOTHER_RANDOM_AT_LEAST_32_CHARS
PUB_RTB_ADULT_URL=http://127.0.0.1:8080/bid_v_2_5
PUB_RTB_MAINSTREAM_URL=http://127.0.0.1:8080/bid_v_2_5_mc
PUB_ADULT_FEED=REGISTER_A_NEW_FEED_IN_EXISTING_ADULT_POP_MAP
PUB_MAINSTREAM_FEED=REGISTER_A_NEW_FEED_IN_EXISTING_MAINSTREAM_POP_MAP
PUB_CALLBACK_ORIGINS=https://adm.example.com
PUB_TRUSTED_PROXIES=127.0.0.1/32
PUB_RTB_TIMEOUT=1500ms
PUB_MAX_INFLIGHT=2048
# EXACT ordered standalone ORTB shards, DB and ready set from SSP Adapter/Kafka Loader.
REDIS_SHARD_ADDRS=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_USE_TLS=false
REDIS_DB_ORTB=2
REDIS_SET_ORTB=ortb:ready
PUB_TELEMETRY_DIR=/var/lib/twinbid-pub/telemetry
# Technical bridge-open confirmation only; original ADM owns trackers/billing.
PUB_CONFIRMED_OPEN_ENABLED=true
PUB_TELEMETRY_MAX_BYTES=536870912

# In EACH SSP Adapter env (not in ADM Adapter):
# PUB_UUID_FEEDS=<exact PUB_ADULT_FEED>,<exact PUB_MAINSTREAM_FEED>
# PUB_INTERNAL_SECRET=<same secret as pub>
# Register those distinct tokens in existing POP Adult/Mainstream feed maps.

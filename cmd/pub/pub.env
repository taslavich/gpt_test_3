# Publisher HTTP API: connections arrive through the external Nginx.
PUB_LISTEN=0.0.0.0:8087
# Public HTTPS origin of the Nginx serving Publisher browser requests.
PUB_PUBLIC_URL=https://twinbidexchange.com
PUBLISHER_REDIS_ADDRS=buffer.twinbidexchange.com:7005
# Must match Publisher Redis DB in cabinet backend (FProj238).
PUBLISHER_REDIS_DB=8
PUBLISHER_REDIS_CLUSTER=false
PUBLISHER_REDIS_USERNAME=
PUBLISHER_REDIS_PASSWORD=redis121
PUBLISHER_REDIS_TLS=false
PUB_INTERNAL_SECRET=218ab43911e85222704607ca1eb91bf22ae41c676d495e5e60204bb5d837e8e8
PUB_DELIVERY_SECRET=ed868718e2f41606a8b66e46791f7c3aff4caae1cc1a1306666f09cd28ce8212
# Publisher sends RTB requests through the shared Nginx (not directly to SSP Adapter).
RTB_ADULT_URL=http://twinbidexchange.com:8086/bid_v_2_5
RTB_MAINSTREAM_URL=http://twinbidexchange.com:8086/bid_v_2_5_mc
PUB_ADULT_FEED=cac977e3-f0b6-403d-afa2-c50ac7c307de
PUB_MAINSTREAM_FEED=1a62ff74-463e-47ad-a3d0-a0786a46aa48
# Legacy env kept empty: delivery no longer checks ADM origins.
PUB_CALLBACK_ORIGINS=
# Only HTTP connections from this Nginx source IP are accepted.
PUB_TRUSTED_PROXIES=138.226.222.12/32
PUB_RTB_TIMEOUT=1500ms
PUB_MAX_INFLIGHT=2048
# EXACT ordered standalone ORTB shards, DB and ready set from SSP Adapter/Kafka Loader.
REDIS_SHARD_ADDRS=buffer.twinbidexchange.com:7000,buffer.twinbidexchange.com:7001,buffer.twinbidexchange.com:7002,buffer.twinbidexchange.com:7003
REDIS_PASSWORD=redis121
REDIS_USE_TLS=false
REDIS_DB_ORTB=4
REDIS_SET_ORTB=ortb_v2:ready
PUB_TELEMETRY_DIR=/var/lib/twinbid-pub/telemetry
# Technical bridge-open confirmation only; original ADM owns trackers/billing.
PUB_CONFIRMED_OPEN_ENABLED=true
PUB_TELEMETRY_MAX_BYTES=536870912

# In EACH SSP Adapter env (not in ADM Adapter):
# PUB_UUID_FEEDS=<exact PUB_ADULT_FEED>,<exact PUB_MAINSTREAM_FEED>
# PUB_INTERNAL_SECRET=<same secret as pub>
# Register those distinct tokens in existing POP Adult/Mainstream feed maps.

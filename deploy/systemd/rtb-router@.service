[Unit]
Description=RTB Router instance %i
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/RTB/gpt_test_3

EnvironmentFile=/root/RTB/gpt_test_3/cmd/router/router.env
Environment=ROUTER_INSTANCE=%i
Environment=HTTP_PORT=806%i

ExecStart=/root/RTB/gpt_test_3/cmd/router/router
Restart=always
RestartSec=1
StartLimitInterval=0

# 🔥 РАЗДЕЛЬНЫЕ ЛОГИ
StandardOutput=append:/var/log/rtb/router-%i.log
StandardError=append:/var/log/rtb/router-%i.error.log
SyslogIdentifier=rtb-router-%i

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

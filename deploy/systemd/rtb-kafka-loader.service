[Unit]
Description=RTB Kafka Loader Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/RTB/gpt_test_3
ExecStart=/root/RTB/gpt_test_3/cmd/kafka-loader/kafka-loader
Restart=always
RestartSec=1
StartLimitInterval=0

# Environment файл из проекта
EnvironmentFile=/root/RTB/gpt_test_3/cmd/kafka-loader/kafka-loader.env

# Logging
StandardOutput=append:/var/log/rtb/kafka-loader.log
StandardError=append:/var/log/rtb/kafka-loader.error.log
SyslogIdentifier=rtb-kafka-loader

# Security
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

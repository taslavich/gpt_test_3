[Unit]
Description=RTB ADV Service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/root/RTB/gpt_test_3
EnvironmentFile=/root/RTB/gpt_test_3/cmd/adv/adv.env
EnvironmentFile=/etc/rtb/common.env
ExecStart=/root/RTB/gpt_test_3/cmd/adv/adv

Restart=always
RestartSec=1
TimeoutStopSec=60

StandardOutput=append:/var/log/rtb/adv.log
StandardError=append:/var/log/rtb/adv.error.log
SyslogIdentifier=rtb-adv

NoNewPrivileges=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
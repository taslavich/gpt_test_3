[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/RTB/gpt_test_3
ExecStart=/root/RTB/gpt_test_3/cmd/router/router
Restart=always
RestartSec=1
StartLimitInterval=0

EnvironmentFile=/root/RTB/gpt_test_3/cmd/router/router.env

# FD / процессы
LimitNOFILE=1048576
LimitNPROC=1048576
LimitMEMLOCK=infinity
TasksMax=infinity

# CPU — приоритет, но не монополия
Nice=-10
CPUWeight=100

CPUAffinity=0-31

# Network backlog (локально)
ExecStartPre=/bin/sh -c 'sysctl -w net.core.somaxconn=65535'
ExecStartPre=/bin/sh -c 'sysctl -w net.ipv4.tcp_max_syn_backlog=65535'

# Logging
StandardOutput=append:/var/log/rtb/router.log
StandardError=append:/var/log/rtb/router.error.log
SyslogIdentifier=rtb-router

NoNewPrivileges=yes
PrivateTmp=yes

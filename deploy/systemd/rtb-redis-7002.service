[Unit]
Description=Redis shard 7002 In-Memory Data Store
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/redis-server /etc/redis-shards/redis-7002.conf --daemonize no
ExecStop=/usr/local/bin/redis-cli -a redis121 -p 7002 shutdown
Restart=always
RestartSec=3
TimeoutStopSec=60

# Logging
StandardOutput=file:/var/log/rtb/redis-7002.log
StandardError=file:/var/log/rtb/redis-7002.error.log
SyslogIdentifier=rtb-redis-7002

# Security
NoNewPrivileges=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

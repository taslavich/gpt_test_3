[Unit]
Description=Redis In-Memory Data Store
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/redis-server /etc/redis/redis.conf --daemonize no
ExecStop=/usr/local/bin/redis-cli shutdown
Restart=always
RestartSec=3
TimeoutStopSec=60

# Logging
StandardOutput=file:/var/log/rtb/redis.log
StandardError=file:/var/log/rtb/redis.error.log
SyslogIdentifier=rtb-redis

# Security
NoNewPrivileges=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
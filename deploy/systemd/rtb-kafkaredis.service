[Unit]
Description=RTB KafkaRedis Service
After=network.target rtb-redis-7005.service
Requires=rtb-redis-7005.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/root/RTB/gpt_test_3
EnvironmentFile=/root/RTB/gpt_test_3/cmd/kafkaredis/kafkaredis.env
ExecStart=/root/RTB/gpt_test_3/cmd/kafkaredis/kafkaredis

Restart=always
RestartSec=1
TimeoutStopSec=60

StandardOutput=append:/var/log/rtb/kafkaredis.log
StandardError=append:/var/log/rtb/kafkaredis.error.log
SyslogIdentifier=rtb-kafkaredis

NoNewPrivileges=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
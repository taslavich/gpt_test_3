[Unit]
Description=RTB Clickhouse Loader Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/RTB/gpt_test_3
ExecStart=/root/RTB/gpt_test_3/cmd/clickhouse-loader/clickhouse-loader
Restart=always
RestartSec=1
StartLimitInterval=0

# Environment файл из проекта
EnvironmentFile=/root/RTB/gpt_test_3/cmd/clickhouse-loader/clickhouse-loader.env
EnvironmentFile=/etc/rtb/common.env

# Logging
StandardOutput=append:/var/log/rtb/clickhouse-loader.log
StandardError=append:/var/log/rtb/clickhouse-loader.error.log
SyslogIdentifier=rtb-clickhouse-loader

# Security
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

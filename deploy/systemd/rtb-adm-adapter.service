[Unit]
Description=RTB ADM Adapter Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/RTB/gpt_test_3 
ExecStart=/root/RTB/gpt_test_3/cmd/adm-adapter/adm-adapter 
Restart=always
RestartSec=1
StartLimitInterval=0

# Environment файл из проекта
EnvironmentFile=/root/RTB/gpt_test_3/cmd/adm-adapter/adm-adapter.env
EnvironmentFile=/etc/rtb/common.env

# Logging
StandardOutput=append:/var/log/rtb/adm-adapter.log
StandardError=append:/var/log/rtb/adm-adapter.error.log
SyslogIdentifier=rtb-adm-adapter

# Security
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

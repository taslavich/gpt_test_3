# Include inside the existing HTTPS server for your public publisher host.
# Keep trusted IP handling consistent with the existing Nginx/LB chain.
location / {
    proxy_pass http://127.0.0.1:8087;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 1s;
    proxy_read_timeout 10s;
    client_max_body_size 16k;
}
# Health/metrics are operational endpoints, not publisher reports.
location = /metrics {
    allow 127.0.0.1;
    deny all;
    proxy_pass http://127.0.0.1:8087;
}

# Add ONLY these directives INSIDE the existing RTB proxy locations
# /bid_v_2_5 and /bid_v_2_5_mc if your proxy currently strips custom headers.
# Do not replace their proxy_pass, upstream, routing, ADM or BURL configuration.
# proxy_set_header X-TwinBid-RTB-UUID $http_x_twinbid_rtb_uuid;
# proxy_set_header X-TwinBid-RTB-UUID-Time $http_x_twinbid_rtb_uuid_time;
# proxy_set_header X-TwinBid-RTB-UUID-Signature $http_x_twinbid_rtb_uuid_signature;
# Pub feed UUID headers are authenticated by HMAC and single-use Redis claim;
# ordinary SSP feeds ignore them. A Host/feed name alone grants no trust.
